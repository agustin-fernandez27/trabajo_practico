def sacar_primo(numero):
#solo divisible por el y por 1:
    divisores = 0

    for i in range(1, numero + 1):
        if numero % i == 0:
            divisores += 1

    if divisores == 2:
        return True

    else:
        return False

print(sacar_primo(4))

def es_multiplo(num:int,num2:int) -> bool:

    if num2 % num == 0:
        print("es multiplo")
        return True
    else:
        print("no es multiplo")
        return False

print(es_multiplo(10,10))

def recursiva (num:int):

    if num == 1:
        return 1
    else:
        return recursiva(num - 1)
    

print(recursiva(4))
